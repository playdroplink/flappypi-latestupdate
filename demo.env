# ========================================
# FLAPPY PI - DEMO.PI CONFIGURATION
# ========================================

# Frontend app URL and bare domain name:
FRONTEND_URL=https://www.flappypi.fun
FRONTEND_DOMAIN_NAME=www.flappypi.fun

# Backend app URL and bare domain name:
BACKEND_URL=https://backend.example.com
BACKEND_DOMAIN_NAME=backend.example.com

# Obtain the following 2 values on the Pi Developer Portal (open develop.pi in the Pi Browser).

# Domain validation key:
DOMAIN_VALIDATION_KEY="312c3da8cf132ea3fd3a8cd40ea7cf4a26da159bbf498808af319e9d6b35e4be5aa50459cd3c81dea595adf9aa4c16428f6dce247015032933797200d1acf156"
# Pi Platform API Key:
PI_API_KEY=zmwtdezqheowvpffxpv9bwwue546iksrfiifspd4iqcqxckp4jc07iifpynqkl0v

# Generate a random string, or roll your face on the keyboard to fill this value:
SESSION_SECRET=abcd1324_TODO

# MongoDB database connection details:
MONGODB_DATABASE_NAME=demoapp
MONGODB_USERNAME=demoapp
MONGODB_PASSWORD=abcd1234

# This will be prepended to all container names.
# Changing this will make docker-compose lose track of all your containers.
# Run `docker-compose down` before changing it.
COMPOSE_PROJECT_NAME=flappypi

# Set this to either "development" or "production" (XXX "staging"?):
ENVIRONMENT=production

# This directory will be used to store all persistent data needed by Docker (using volumes):
DATA_DIRECTORY=./docker-data

# URL of the Pi Platform API - you should not need to change this.
PLATFORM_API_URL=https://api.minepi.com

# ========================================
# ADDITIONAL FLAPPY PI CONFIGURATION
# ========================================

# Pi Network Configuration for demo.pi
PI_NETWORK_APP_ID=flappypi6856
PI_NETWORK_API_KEY=zmwtdezqheowvpffxpv9bwwue546iksrfiifspd4iqcqxckp4jc07iifpynqkl0v
PI_NETWORK_VALIDATION_KEY=312c3da8cf132ea3fd3a8cd40ea7cf4a26da159bbf498808af319e9d6b35e4be5aa50459cd3c81dea595adf9aa4c16428f6dce247015032933797200d1acf156

# Pi Network Environment Settings
PI_SANDBOX_MODE=false
PI_NETWORK=mainnet
VITE_PI_NETWORK=mainnet

# Pi Network API URLs
PI_API_URL=https://api.minepi.com
PI_NETWORK_API_URL=https://api.minepi.com

# Pi Network Wallet Configuration
PI_WALLET_ADDRESS=GBVTV77XFMDYSSVIG6ZGSRAGZ3S7KA4275YYLOLIROOD3Y3F3TH5U3EI
TRUTHWEB_WALLET_ADDRESS=GBVTV77XFMDYSSVIG6ZGSRAGZ3S7KA4275YYLOLIROOD3Y3F3TH5U3EI
MERCHANT_WALLET_ADDRESS=GBVTV77XFMDYSSVIG6ZGSRAGZ3S7KA4275YYLOLIROOD3Y3F3TH5U3EI

# Environment Settings
NODE_ENV=development
FLAPPY_PI_ENV=development
GAME_ENVIRONMENT=development

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_LEADERBOARD=true
ENABLE_DEBUG=true

# Server Configuration
PORT=3000
APIKEY=zmwtdezqheowvpffxpv9bwwue546iksrfiifspd4iqcqxckp4jc07iifpynqkl0v

# CORS Origins
ALLOWED_ORIGINS=https://www.flappypi.fun,https://flappypi6856.pinet.com,https://*.pinet.com,https://*.minepi.com

# Pi Network Security
PI_REQUIRE_BROWSER=false
PI_REQUIRE_AUTH=false
PI_VALIDATE_PAYMENTS=false

# Debug Settings
DEBUG_MODE=true
FLAPPY_DEBUG=true
FLAPPY_PI_DEBUG=true
MUSIC_DEBUG=true

# Audio Settings
AUDIO_ENABLED=true
MUSIC_ENABLED=true
SFX_ENABLED=true

# Game Settings
GAME_MODE=production
TESTNET_MODE=false
MAINNET_MODE=true
SANDBOX_MODE=false

# Analytics Configuration
ANALYTICS_ENABLED=true
ERROR_TRACKING_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true

# PiNet Settings
PINET_MODE=true
PINET_ENABLED=true
PINET_ECOSYSTEM=true
PINET_SUBDOMAIN=flappypi6856.pinet.com
PINET_BASE_URL=https://www.flappypi.fun
